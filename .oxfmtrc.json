{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "printWidth": 100,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": {
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true,
    "internalPattern": ["@/*", "~/"]
  },
  "sortPackageJson": true,
  "jsdoc": true,
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "dist/**",
    "*.min.js",
    "*.min.css",
    "src/db/migrations/**"
  ]
}
