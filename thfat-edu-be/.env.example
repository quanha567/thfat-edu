# ==============================================================================
# ThFat Edu Backend - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env before starting the server or running migrations:
#   cp .env.example .env
# ==============================================================================

# Server Environment Mode: development | production | test
NODE_ENV=development

# Server Port (Default: 3001)
PORT=3001

# PostgreSQL Connection String
# Example: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thfat_edu

# Frontend Application Origin (used for CORS and secure Cookie handling)
FRONTEND_URL=http://localhost:3000

# Secret Key for JWT Signing & Session Security (minimum 16 characters)
JWT_SECRET=thfat_edu_dev_secret_key_replace_with_secure_random_string_in_production

# Optional initial system admin email for database seeding (`bun run db:seed`)
ADMIN_EMAIL=admin@thfat.edu.vn

# ==============================================================================
# Firebase Admin SDK Configuration
# ==============================================================================
# Choose either Option 1 (inline environment variables) or Option 2 (service account file).
#
# Option 1: Inline Service Account credentials (recommended for production/Vercel)
FIREBASE_PROJECT_ID=thfat-edu
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@thfat-edu.iam.gserviceaccount.com
# Note: For private key, keep quotes and escape line breaks with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to downloaded Firebase service account JSON file (convenient for local dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

