{
  "name": "thfat-edu",
  "private": true,
  "workspaces": [
    "thfat-edu-fe",
    "thfat-edu-be"
  ],
  "scripts": {
    "dev:fe": "bun --filter thfat-edu-fe dev",
    "dev:be": "bun --filter thfat-edu-be dev",
    "lint": "bun --filter thfat-edu-fe lint",
    "format": "bun --filter thfat-edu-fe format",
    "format:check": "bun --filter thfat-edu-fe format:check",
    "typecheck": "bun --filter thfat-edu-fe typecheck && bun --filter thfat-edu-be typecheck",
    "test": "bun --filter thfat-edu-fe test",
    "build": "bun --filter thfat-edu-fe build",
    "scan": "bun pm scan",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "elysia": "^1.4.30",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "typescript": "^5.9.3"
  }
}
